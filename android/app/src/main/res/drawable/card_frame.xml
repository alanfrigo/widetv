<?xml version="1.0" encoding="utf-8"?>
<!--
  Moldura do card 16:9 / 2:3, desenhada POR CIMA da imagem (`android:foreground`):
  contorno no acento so quando o card tem o foco (redesign-contract.md §3.4).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/stroke_focus_card"
                android:color="@color/accent" />
            <corners android:radius="@dimen/radius_16" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_16" />
        </shape>
    </item>
</selector>
