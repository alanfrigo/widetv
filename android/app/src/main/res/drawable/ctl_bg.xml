<?xml version="1.0" encoding="utf-8"?>
<!--
  Botões redondos/quadrados do OSD do player (áudio e legendas, tela cheia, ±10).
  Focado ganha a borda de acento (mesma linguagem de card_frame); o corpo escuro
  fica como está para o glifo continuar legível sobre o vídeo.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ctl_bg" />
            <stroke android:width="@dimen/stroke_focus_card" android:color="@color/accent" />
            <corners android:radius="@dimen/radius_14" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ctl_bg" />
            <stroke android:width="1dp" android:color="@color/white_18" />
            <corners android:radius="@dimen/radius_14" />
        </shape>
    </item>
</selector>
