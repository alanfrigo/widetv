<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de episódio: sem fundo em repouso (o design a mostra "solta"). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_row_hi" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="@dimen/radius_16" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_row_hi" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="@dimen/radius_16" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius_16" />
        </shape>
    </item>
</selector>
