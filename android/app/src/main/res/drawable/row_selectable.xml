<?xml version="1.0" encoding="utf-8"?>
<!--
  Linha de lista (episodio, trilha). No foco ganha fundo e uma barra de acento
  a esquerda: numa TV o contorno sozinho some a tres metros de distancia.
-->
<!--
  `state_selected` existe para o painel de trilhas, cujo cursor e do reducer e
  nao do sistema de foco: as linhas de la nunca sao focaveis, senao as setas
  seriam consumidas pelo RecyclerView antes de chegar ao reducer.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_high" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item android:width="4dp" android:gravity="start|fill_vertical">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_high" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item android:width="4dp" android:gravity="start|fill_vertical">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
