<?xml version="1.0" encoding="utf-8"?>
<!--
  Botao de acao. Em repouso e so contorno: numa tela de TV, dois botoes cheios
  brigariam para dizer qual esta selecionado. Cheio significa "o foco esta aqui".
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_high" />
            <stroke
                android:width="1dp"
                android:color="@color/accent_dim" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
