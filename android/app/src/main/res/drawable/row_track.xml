<?xml version="1.0" encoding="utf-8"?>
<!--
  Três estados (AND-KT): `state_selected` é a faixa tocando (duplicateParentState
  no radio), `state_activated` é o cursor do controle remoto, sem seleção. A
  faixa tocando vence quando as duas coincidem — é a informação mais importante
  da linha.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_12" />
            <stroke android:width="1dp" android:color="@color/accent_45" />
            <corners android:radius="@dimen/radius_14" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white_09" />
            <corners android:radius="@dimen/radius_14" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white_04" />
            <corners android:radius="@dimen/radius_14" />
        </shape>
    </item>
</selector>
