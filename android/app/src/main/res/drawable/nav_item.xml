<?xml version="1.0" encoding="utf-8"?>
<!-- Item da nav da topbar (Início / Ao vivo / Séries). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focado E ativo primeiro: sem este item o `state_selected` venceria e o
         anel de foco sumiria justamente sobre a aba já escolhida. -->
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white_08" />
            <stroke android:width="@dimen/stroke_focus" android:color="@color/accent" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white_08" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/stroke_focus" android:color="@color/accent" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
