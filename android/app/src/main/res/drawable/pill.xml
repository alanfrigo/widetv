<?xml version="1.0" encoding="utf-8"?>
<!--
  Pill de fundo dos controles redondos fora do player. Focado ganha a borda de
  acento (mesma linguagem de card_frame); o corpo escuro nao muda para o texto
  manter o contraste.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ctl_bg" />
            <stroke android:width="@dimen/stroke_focus_card" android:color="@color/accent" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ctl_bg" />
            <stroke android:width="1dp" android:color="@color/line_strong" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
