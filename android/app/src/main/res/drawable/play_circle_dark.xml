<?xml version="1.0" encoding="utf-8"?>
<!--
  Selo escuro de play sobre a arte (card "Continuar assistindo", linha de
  episódio). Focado ganha a borda de acento (mesma linguagem de card_frame).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/overlay_veil" />
            <stroke android:width="@dimen/stroke_focus_card" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/overlay_veil" />
            <stroke android:width="1dp" android:color="@color/white_22" />
        </shape>
    </item>
</selector>
