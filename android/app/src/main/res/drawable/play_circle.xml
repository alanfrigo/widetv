<?xml version="1.0" encoding="utf-8"?>
<!--
  Play/pause do OSD do player. Cheio de acento, entao a borda de acento seria
  invisível: focado clareia o fundo, mesma linguagem de btn_primary.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/accent_hover" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/accent_hover" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/accent" />
        </shape>
    </item>
</selector>
