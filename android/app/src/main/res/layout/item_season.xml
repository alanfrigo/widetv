<?xml version="1.0" encoding="utf-8"?>
<!--
  Aba de temporada. O estado ativo vem de `isSelected` (o `season_tab` pinta o
  fundo de acento) e o foco do D-pad e independente — dessa forma dar uma volta
  pelas abas nao troca a temporada sozinho.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/season_tab"
    android:layout_width="wrap_content"
    android:layout_height="33dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/season_tab"
    android:focusable="true"
    android:gravity="center"
    android:paddingStart="17dp"
    android:paddingEnd="17dp"
    android:textColor="@color/text_2"
    android:textSize="@dimen/text_card"
    android:textStyle="bold" />
