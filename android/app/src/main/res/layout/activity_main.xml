<?xml version="1.0" encoding="utf-8"?>
<!--
  Uma Activity, quatro telas empilhadas por visibilidade: player, catalogo,
  serie e portao de acesso. Trocar de tela e trocar visibilidade — nao ha
  Fragment, nao ha navegacao e nao ha transicao a esperar.

  A ordem so importa no empilhamento: o portao fica por ultimo porque, quando
  aparece, nada mais pode receber foco.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- ================= PLAYER ================= -->
    <FrameLayout
        android:id="@+id/player_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone">

        <!--
          Sem controles na tela: o controle remoto ja e a interface, e uma barra
          de play flutuando tiraria espaco do desenho. As legendas escolhidas no
          painel saem pela SubtitleView que a propria PlayerView carrega.
        -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:focusable="false"
            app:resize_mode="fit"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <!-- Pilula de informacao: aparece na troca de episodio e some sozinha. -->
        <TextView
            android:id="@+id/osd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="@dimen/space_lg"
            android:background="@drawable/osd_pill"
            android:maxLines="1"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="10dp"
            android:textColor="@color/text"
            android:textSize="@dimen/text_osd"
            android:visibility="gone" />

        <!--
          Painel de trilhas (OK durante a reproducao). Lateral, e nao modal no
          centro: quem escolhe legenda quer ver o efeito na cena atras.

          `blocksDescendants`: o cursor do painel e do reducer. Se as linhas
          fossem focaveis, o RecyclerView comeria as setas antes de elas
          chegarem ao `onKeyDown` da Activity.
        -->
        <LinearLayout
            android:id="@+id/tracks"
            android:layout_width="@dimen/track_panel_width"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_sm"
                android:text="@string/tracks_title"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/track_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_weight="1"
                android:descendantFocusability="blocksDescendants"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="@dimen/space_sm"
                android:text="@string/tracks_hint"
                android:textColor="@color/text_faint"
                android:textSize="@dimen/text_meta" />
        </LinearLayout>
    </FrameLayout>

    <!-- ================= CATALOGO ================= -->
    <LinearLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/space_xl"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.22"
            android:text="@string/gate_wordmark"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_section"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/home_title"
            android:textColor="@color/text"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_weight="1">

            <!--
              `clipChildren=false` + folga em volta: o card em foco cresce 6% e
              precisa de onde crescer, senao a fileira da borda aparece cortada.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="@dimen/space_lg" />

            <TextView
                android:id="@+id/home_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- ================= SERIE ================= -->
    <LinearLayout
        android:id="@+id/series"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_lg"
        android:visibility="gone">

        <com.widetv.app.ui.PosterFrame
            android:id="@+id/series_art"
            android:layout_width="@dimen/series_poster_width"
            android:layout_height="wrap_content"
            android:background="@drawable/poster_placeholder">

            <ImageView
                android:id="@+id/series_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_poster"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/series_initials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/text_faint"
                android:textSize="64sp"
                android:textStyle="bold" />
        </com.widetv.app.ui.PosterFrame>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/series_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/series_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/series_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.25"
                android:maxLines="5"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/text_body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/series_live"
                    style="@style/WideTv.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/series_live" />

                <TextView
                    android:id="@+id/series_start"
                    style="@style/WideTv.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="@string/series_start" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:letterSpacing="0.16"
                android:text="@string/series_episodes"
                android:textColor="@color/text_faint"
                android:textSize="@dimen/text_meta"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/series_episodes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================= ACESSO ================= -->
    <LinearLayout
        android:id="@+id/gate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_xl"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:text="@string/gate_wordmark"
            android:textColor="@color/text"
            android:textSize="@dimen/text_wordmark"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/gate_subtitle"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/text_body" />

        <TextView
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:letterSpacing="0.14"
            android:text="@string/gate_server_label"
            android:textColor="@color/text_faint"
            android:textSize="@dimen/text_meta"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/gate_server"
            style="@style/WideTv.Field"
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:autofillHints="no"
            android:hint="@string/gate_server_hint"
            android:imeOptions="actionNext"
            android:inputType="textUri" />

        <TextView
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:letterSpacing="0.14"
            android:text="@string/gate_password_label"
            android:textColor="@color/text_faint"
            android:textSize="@dimen/text_meta"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/gate_password"
            style="@style/WideTv.Field"
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:autofillHints="no"
            android:hint="@string/gate_password_hint"
            android:imeOptions="actionDone"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/gate_submit"
            style="@style/WideTv.Button"
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/gate_enter" />

        <TextView
            android:id="@+id/gate_error"
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textColor="@color/danger"
            android:textSize="@dimen/text_meta" />
    </LinearLayout>
</FrameLayout>
