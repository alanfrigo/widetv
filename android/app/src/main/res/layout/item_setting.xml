<?xml version="1.0" encoding="utf-8"?>
<!--
  Uma linha da tela de configuracoes: nome e dica a esquerda, valor entre as
  duas setas a direita.

  A linha NAO e focavel: o cursor e do reducer (o RecyclerView tem
  `blocksDescendants` para as setas chegarem inteiras ao `onKeyDown` da
  Activity). O estado da linha vem de `isSelected`, e o `row_setting` desenha o
  fundo mais claro com o contorno de acento.

  As setas existem sempre; quem as mostra ou esconde e o adapter — nas linhas de
  acao (as que executam algo em vez de mudar um valor) a seta esquerda some.

  Alvo alto de proposito: a tres metros de distancia, uma lista apertada vira um
  bloco de texto e ninguem acha onde o cursor esta.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setting_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/row_setting"
    android:focusable="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="15dp"
    android:paddingTop="13dp"
    android:paddingEnd="15dp"
    android:paddingBottom="13dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/setting_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setting_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_meta"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/setting_arrow_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:importantForAccessibility="no"
        android:text="@string/glyph_arrow_left"
        android:textColor="@color/dim"
        android:textSize="@dimen/text_body"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/setting_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:minWidth="120dp"
        android:textColor="@color/text_2"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/setting_arrow_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:importantForAccessibility="no"
        android:text="@string/glyph_arrow_right"
        android:textColor="@color/dim"
        android:textSize="@dimen/text_body"
        android:visibility="invisible" />
</LinearLayout>
