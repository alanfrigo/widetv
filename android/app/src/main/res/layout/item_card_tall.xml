<?xml version="1.0" encoding="utf-8"?>
<!--
  Card 2:3 da faixa "Todo o acervo". Substitui o antigo `item_poster.xml`.

  A altura da capa sai da largura (`PosterFrame` forca 3/2), por isso o card
  continua correto em qualquer resolucao de TV sem ninguem medir nada em codigo.
  O item inteiro recebe o foco e a moldura de acento vive no `foreground` da
  arte, que copia o estado do pai (`duplicateParentState`).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="@dimen/card_tall_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/rail_gap_tall"
    android:focusable="true"
    android:orientation="vertical">

    <com.widetv.app.ui.PosterFrame
        android:id="@+id/card_art"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/stripes"
        android:duplicateParentState="true"
        android:foreground="@drawable/card_frame">

        <ImageView
            android:id="@+id/card_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_poster"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Iniciais da serie. Some assim que a capa chega. -->
        <TextView
            android:id="@+id/card_initials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/manrope_extrabold"
            android:gravity="center"
            android:textColor="@color/ghost"
            android:textSize="@dimen/text_settings"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_chan"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/badge_dark"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/text"
            android:textSize="@dimen/text_tag"
            android:textStyle="bold" />

        <!-- Selo de resolucao. O desenho o esconde enquanto o card esta focado. -->
        <TextView
            android:id="@+id/card_badge"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="9dp"
            android:background="@drawable/badge_dark"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:textColor="@color/text"
            android:textSize="@dimen/text_tag"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/card_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:indeterminate="false"
            android:max="1000"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:progressDrawable="@drawable/progress_track"
            android:visibility="gone" />
    </com.widetv.app.ui.PosterFrame>

    <TextView
        android:id="@+id/card_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.25"
        android:maxLines="2"
        android:textColor="@color/text"
        android:textSize="@dimen/text_card"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/card_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textSize="@dimen/text_micro" />
</LinearLayout>
