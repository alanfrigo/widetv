<?xml version="1.0" encoding="utf-8"?>
<!--
  Cabecalho de secao do painel de trilhas ("Audio", "Legendas neste episodio").
  Nunca recebe foco: e so um rotulo dentro da mesma lista das trilhas — no
  Android o painel usa UMA lista com cabecalhos, e nao duas listas como a web.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/track_section"
    style="@style/WideTv.Legend"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="false"
    android:paddingTop="12dp"
    android:paddingBottom="6dp" />
