<?xml version="1.0" encoding="utf-8"?>
<!--
  Card do catalogo: capa 2:3, nome e a linha "2025 · 22 EP".

  A largura vem da coluna da grade; a altura da capa sai dela (`PosterFrame`).
  O item inteiro e o que recebe o foco, e a moldura de acento vive no
  `foreground` da arte, que copia o estado do pai (`duplicateParentState`). A
  escala e a elevacao sao animadas no ViewHolder.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/card_gap"
    android:layout_marginEnd="@dimen/card_gap"
    android:layout_marginBottom="@dimen/space_md"
    android:focusable="true"
    android:orientation="vertical">

    <com.widetv.app.ui.PosterFrame
        android:id="@+id/card_art"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/poster_placeholder"
        android:duplicateParentState="true"
        android:foreground="@drawable/card_frame">

        <ImageView
            android:id="@+id/card_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_poster"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Iniciais da serie. Some assim que a capa chega. -->
        <TextView
            android:id="@+id/card_initials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/text_faint"
            android:textSize="@dimen/text_initials"
            android:textStyle="bold" />
    </com.widetv.app.ui.PosterFrame>

    <TextView
        android:id="@+id/card_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text"
        android:textSize="@dimen/text_card" />

    <TextView
        android:id="@+id/card_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_dim"
        android:textSize="@dimen/text_meta" />
</LinearLayout>
