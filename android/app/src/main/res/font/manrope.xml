<?xml version="1.0" encoding="utf-8"?>
<!--
  Família Manrope (docs/redesign-contract.md §3.3). minSdk 23 não resolve
  fontFamily por peso nativamente (isso só chega na API 26) — o app depende do
  AppCompat para isso, por isso cada <font> carrega o atributo duplicado
  `android:` + `app:`. Onde o design pede 800 e `textStyle="bold"` não basta
  (minSdk 23 não tem fontVariationSettings), use diretamente
  `@font/manrope_extrabold` na view.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/manrope_regular"
        app:fontStyle="normal"
        app:fontWeight="400"
        app:font="@font/manrope_regular" />
    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/manrope_medium"
        app:fontStyle="normal"
        app:fontWeight="500"
        app:font="@font/manrope_medium" />
    <font
        android:fontStyle="normal"
        android:fontWeight="600"
        android:font="@font/manrope_semibold"
        app:fontStyle="normal"
        app:fontWeight="600"
        app:font="@font/manrope_semibold" />
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/manrope_bold"
        app:fontStyle="normal"
        app:fontWeight="700"
        app:font="@font/manrope_bold" />
    <font
        android:fontStyle="normal"
        android:fontWeight="800"
        android:font="@font/manrope_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800"
        app:font="@font/manrope_extrabold" />
</font-family>
