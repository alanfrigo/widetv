{
  "name": "widetv",
  "version": "0.1.0",
  "description": "Servidor pessoal de streaming",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "NODE_ENV=development tsx watch --include .env --env-file=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server && npm run build:scan && npm run build:remux",
    "build:web": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --alias:@shared=./src/shared --outfile=dist/server/index.js",
    "build:scan": "esbuild src/server/cli/scan.ts --bundle --platform=node --target=node22 --format=esm --packages=external --alias:@shared=./src/shared --outfile=dist/server/scan.js",
    "build:remux": "esbuild src/server/cli/remux.ts --bundle --platform=node --target=node22 --format=esm --packages=external --alias:@shared=./src/shared --outfile=dist/server/remux.js",
    "start": "node dist/server/index.js",
    "scan": "tsx src/server/cli/scan.ts",
    "remux": "tsx src/server/cli/remux.ts",
    "survey": "tsx src/server/cli/survey.ts",
    "hash-password": "tsx src/server/cli/hash-password.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
