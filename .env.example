# Raiz da biblioteca, montada read-only no container.
# Aceita RAIZ/SERIE/*.mp4 e RAIZ/SERIE/TEMPORADA N/*.mp4
LIBRARY_ROOT=/media/biblioteca

# Onde ficam o indice SQLite, as capas baixadas e o cache de legenda (precisa
# ser gravavel). Nao deixe em branco: em branco vira ./data, que dentro do
# container e /app/data, sem volume e sem permissao de escrita.
DATA_DIR=./data

# Indexa o acervo sozinho quando o indice esta vazio, em segundo plano, sem
# atrasar o boot. Deixe ligado num NAS, onde nao ha shell no container.
# So "false" desliga.
AUTO_SCAN=true

# Rescan diario da biblioteca, no horario LOCAL (TZ do container): adiciona o
# que chegou e remove o que saiu do disco, sozinho. Formato HH:MM; "off"
# desliga. Rodar de novo e barato: so arquivo novo/mudado passa pelo ffprobe.
RESCAN_TIME=04:00

# Converte para MP4, em segundo plano, os episodios que o navegador nao toca
# direto do disco (MKV, audio Dolby como faixa principal). NAO e transcode:
# video e Dolby sao copiados byte a byte, so entra uma faixa AAC extra de
# compatibilidade - zero perda de qualidade e quase zero CPU. As copias vivem
# em DATA_DIR/remux e ocupam mais ou menos o tamanho dos proprios MKV: garanta
# esse espaco, ou desligue com "false" (os MKV voltam a ser servidos crus).
AUTO_REMUX=true

# Tira um quadro de cada episodio, em segundo plano, para a lista de episodios e
# para as faixas "No ar agora" e "Continuar assistindo" - nenhum provedor de
# metadata tem imagem por episodio de acervo caseiro. Um ffmpeg por arquivo,
# um por vez, cedendo a vez ao remux: barato por episodio, longo num acervo
# grande. Os JPEG vivem em DATA_DIR/thumbs e ocupam uns 30 KB cada. "false"
# desliga (o que ja foi gerado continua sendo servido).
AUTO_THUMBS=true

# Junta pastas de release da mesma serie num canal so: "Nome.S01.1080p..." e
# "Nome.S02.1080p..." viram um canal so, com as duas temporadas, em vez de
# dois canais com nome de release. Vale para qualquer serie no mesmo padrao.
# Ligado por padrao porque e assim que a maioria dos releases vem. Desligue
# com "false" se o seu acervo ja e uma pasta por serie e o agrupamento so
# atrapalharia. So a string exata "false" desliga.
# O painel de configuracoes pode sobrepor este valor: gravar la substitui o
# que esta aqui, e apagar a escolha no painel volta a usar o valor daqui.
SMART_GROUPING=true

# Opcional. Com a chave, o TMDB entra na frente da busca de capa e traz poster
# de cartaz e sinopse em pt-BR. Sem ela o servidor usa TVMaze e iTunes, que nao
# pedem chave nenhuma; o que muda e a qualidade da capa, nao o funcionamento.
# TMDB_API_KEY=

# Porta HTTP do servidor
PORT=8080

# Instante zero da grade ao vivo. Nao mude depois de subir em producao:
# mudar isso reposiciona todos os canais de uma vez.
CHANNEL_EPOCH=2024-01-01T00:00:00Z

# Senha unica de acesso, guardada como hash scrypt.
# E o HASH que vai aqui, nunca a senha em texto claro.
# Gere com: npm run hash-password
AUTH_PASSWORD_HASH=

# Segredo para assinar o cookie de sessao (32+ bytes aleatorios).
# Gere com: openssl rand -hex 32
SESSION_SECRET=

# Quando o cookie de sessao recebe a flag Secure. Deixe VAZIO na duvida.
#
#   (vazio)  auto  - marca Secure so quando a chamada chegou por HTTPS, seja
#                    TLS direto ou `x-forwarded-proto: https` de um proxy.
#   true           - marca sempre, mesmo em HTTP.
#   false          - nunca marca.
#
# Por que o default e `auto`: um cookie Secure entregue por HTTP e guardado
# pelo cliente e nunca reenviado. Servidor na LAN, sem TLS, com Secure fixo, o
# login responde 200 e a proxima chamada volta 401 - o app de TV fica piscando
# entre a senha e o catalogo. O navegador so escapa disso em `localhost`, que
# ele trata como origem segura por excecao, entao o defeito aparece primeiro no
# celular e na TV. Use `true` so quando TODO acesso for por HTTPS.
SECURE_COOKIES=
