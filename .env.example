# Raiz da biblioteca de desenhos, montada read-only no container.
# Aceita RAIZ/SERIE/*.mp4 e RAIZ/SERIE/TEMPORADA N/*.mp4
LIBRARY_ROOT=/media/desenhos

# Onde fica o indice SQLite (precisa ser gravavel).
# Nao deixe em branco: em branco vira ./data, que dentro do container e
# /app/data, sem volume e sem permissao de escrita.
DATA_DIR=./data

# Indexa o acervo sozinho quando o indice esta vazio, em segundo plano, sem
# atrasar o boot. Deixe ligado num NAS, onde nao ha shell no container.
# So "false" desliga.
AUTO_SCAN=true

# Modo de apresentacao dos clientes (web e Android):
#   crt        - TV retro 4:3 com filtro CRT (default, liga-e-toca)
#   widescreen - 16:9 sem filtro, com lista de canais + catalogo sob demanda,
#                para acervos FullHD/4K
# Valor invalido derruba o boot de proposito, em vez de cair no default calado.
DISPLAY_MODE=crt

# Porta HTTP do servidor
PORT=8080

# Instante zero da grade. Nao mude depois de subir em producao:
# mudar isso reposiciona todos os canais de uma vez.
CHANNEL_EPOCH=2024-01-01T00:00:00Z

# Senha unica de acesso, guardada como hash scrypt.
# E o HASH que vai aqui, nunca a senha em texto claro.
# Gere com: npm run hash-password
AUTH_PASSWORD_HASH=

# Segredo para assinar o cookie de sessao (32+ bytes aleatorios).
# Gere com: openssl rand -hex 32
SESSION_SECRET=

# Marque true quando estiver atras de um reverse proxy com HTTPS.
# Com false o cookie de sessao NAO recebe a flag Secure.
SECURE_COOKIES=true
